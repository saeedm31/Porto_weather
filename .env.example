# Database (local PostgreSQL or AWS RDS endpoint)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASS=your_db_password_here

# Location (default: Porto, Portugal). Change all four for another city.
CITY_NAME=Porto
CITY_LAT=41.15
CITY_LON=-8.61
TIMEZONE=Europe/Lisbon

# First day to download. 1991 gives a full 1991-2020 climate normal.
BACKFILL_START=1991-01-01

# Dashboard server
HOST=0.0.0.0
PORT=5000
